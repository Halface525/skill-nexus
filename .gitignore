# ════════════════════════════════════════
# SkillNexus .gitignore
# ════════════════════════════════════════

# ── Node / Vite ─────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
*.local

# ── 环境变量 ────────────────────────────
.env
.env.*
!.env.example

# ── 日志 ────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDE ─────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Claude Code 本地设置(不提交)────────
.claude/settings.local.json

# ── 操作系统 ────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── 其它 ────────────────────────────────
*.sw?
*~
